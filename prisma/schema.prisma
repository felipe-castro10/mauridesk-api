// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  avatar        String?
  password_hash String
  type_user     String

  // Tickets que o usuário CRIOU
  ticketsCreated Ticket[] @relation("TicketCreator")

  // Tickets que o técnico ATENDE
  ticketsAssigned Ticket[] @relation("TicketTechnician")

  created_at     DateTime        @default(now())
  updated_at     DateTime?       @updatedAt
  branch         Branch?         @relation(fields: [branch_id], references: [id])
  branch_id      String?
  ticketMessages TicketMessage[]

  @@map("users")
}

model Ticket {
  id                String @id @default(uuid())
  title             String
  description       String
  dynamic_responses Json?  @default("{}")
  department        String

  status   String @default("OPEN")
  priority String @default("LOW")

  creator_id String
  creator    User   @relation("TicketCreator", fields: [creator_id], references: [id])

  technician_id String?
  technician    User?   @relation("TicketTechnician", fields: [technician_id], references: [id])

  branch    Branch? @relation(fields: [branch_id], references: [id])
  branch_id String?

  category_id String
  category    Category @relation(fields: [category_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  //struct SLA
  first_response_at DateTime?
  resolved          Boolean   @default(false)
  closed_at         DateTime?

  sla_due_at   DateTime // prazo máximo de resolução
  sla_violated Boolean  @default(false)

  ticketMessages TicketMessage[]
  attachments    Attachment[]

  @@map("tickets")
}

model Attachment {
  id         String   @id @default(uuid())
  path       String
  type       String
  ticket_id  String
  ticket     Ticket   @relation(fields: [ticket_id], references: [id])
  created_at DateTime @default(now())
}

model Branch {
  id   String @id @default(uuid())
  name String
  cnpj String @unique

  users      User[]
  tickets    Ticket[]
  created_at DateTime @default(now())

  @@map("branchs")
}

model TicketMessage {
  id         String   @id @default(uuid())
  text       String
  created_at DateTime @default(now())

  ticket    Ticket @relation(fields: [ticket_id], references: [id])
  ticket_id String

  user    User   @relation(fields: [user_id], references: [id])
  user_id String
}

model Category {
  id            String   @id @default(uuid())
  name          String
  custom_fields Json     @default("[]")
  tickets       Ticket[]

  @@map("categories")
}
